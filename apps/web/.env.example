# ---------------------------------------------------------------------------
# Admin console configuration. Copy to .env and fill in.
# Everything here ships in the browser bundle — never put a service-role key
# or any other secret in this file.
# ---------------------------------------------------------------------------

# The Express backend, including /api/v1.
VITE_API_BASE_URL=http://localhost:4000/api/v1

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# MapLibre-compatible vector style used by the battery-station map picker.
# Optional: without it the picker falls back to manual coordinate entry, and
# the rest of the console is unaffected.
#
# Default is OpenFreeMap — free OpenStreetMap vector tiles, no API key, no
# quota. Keep this in sync with EXPO_PUBLIC_MAP_STYLE_URL in apps/mobile/.env
# so an admin picking a location sees the same map a rider does.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
#
# Optional dark-theme style, used when the console is switched to dark mode.
# Defaults to CARTO "dark matter" (key-less, MapLibre-compatible) when unset.
# VITE_MAP_STYLE_URL_DARK=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
