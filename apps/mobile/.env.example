# ---------------------------------------------------------------------------
# All three are REQUIRED. There is no mock/offline mode: the app always talks
# to the real backend, so a missing value fails loudly at startup rather than
# silently serving fake data.
#
# Only EXPO_PUBLIC_* is visible to the app, and everything in the bundle is
# readable by anyone with the APK. Never put the service-role key here.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The Express backend, including /api/v1.
# Note: localhost from a phone means the PHONE, not your PC. Use your machine's
# LAN IP (the one Metro prints), or 10.0.2.2 for an Android emulator.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# ---------------------------------------------------------------------------
# Auth notes (no client secrets needed here):
# - Phone OTP is native Supabase Auth; MSG91 is wired on the Supabase side via
#   the send-sms Edge Function, so the app needs no MSG91 keys.
# - Google Sign-In uses Supabase's browser OAuth flow. The redirect deep link
#   is  nrevscooters://auth-callback  (scheme from app.json). Add it to your
#   Supabase project's Auth → URL Configuration → Redirect URLs.
# ---------------------------------------------------------------------------
