# ---------------------------------------------------------------------------
# All three are REQUIRED. There is no mock/offline mode: the app always talks
# to the real backend, so a missing value fails loudly at startup rather than
# silently serving fake data.
#
# Only EXPO_PUBLIC_* is visible to the app, and everything in the bundle is
# readable by anyone with the APK. Never put the service-role key here.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The Express backend, including /api/v1.
# Note: localhost from a phone means the PHONE, not your PC. Use your machine's
# LAN IP (the one Metro prints), or 10.0.2.2 for an Android emulator.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# ---------------------------------------------------------------------------
# Auth notes (no client secrets needed here):
# - Phone OTP is native Supabase Auth; MSG91 is wired on the Supabase side via
#   the send-sms Edge Function, so the app needs no MSG91 keys.
# - Google Sign-In uses Supabase's browser OAuth flow. The redirect deep link
#   is  nrevscooters://auth-callback  (scheme from app.json). Add it to your
#   Supabase project's Auth → URL Configuration → Redirect URLs.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Battery Stations map. A MapLibre-compatible vector style URL — the renderer
# (MapLibre) is free and open source; the TILES are a separate service, which
# is why this is configuration rather than a constant. Optional: without it the
# map screen renders a "map not configured" notice and the rest of the app is
# unaffected.
#
# Default below is OpenFreeMap — free OpenStreetMap vector tiles, no API key,
# no quota, donation-funded. Full street-level detail.
#
# Do NOT use https://demotiles.maplibre.org/style.json for anything real: it is
# a demo style with country borders and no streets.
#
# Other MapLibre-compatible options, all drop-in replacements for this URL:
#   - Protomaps      self-host one .pmtiles file; free software, your storage
#   - MapTiler       free tier, needs an API key in the URL
#   - Stadia Maps    free tier, needs an API key in the URL
# ---------------------------------------------------------------------------
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# ---------------------------------------------------------------------------
# Area search on the Battery Stations map. A Photon-compatible geocoding
# endpoint — typing a locality ("Adyar") resolves it to coordinates so the app
# can recommend the nearest stations, including for areas with no station of
# their own. Keyless, like the map style. Optional: unset simply means the
# search box keeps matching station names and QIS IDs, as it did before.
#
# Photon rather than Nominatim because it is built for type-ahead and accepts a
# lat/lon bias; Nominatim's usage policy explicitly discourages per-keystroke
# querying. The public instance below is community-run — self-host Photon
# (https://github.com/komoot/photon) for production traffic.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_GEOCODE_URL=https://photon.komoot.io/api
