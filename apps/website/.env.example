# ---------------------------------------------------------------------------
# Public marketing site. Fully static — no Supabase/API calls — so the only
# configuration it needs is where the *other* Swapngo apps live, since this
# site is the public entry point that links out to them.
# ---------------------------------------------------------------------------

# Where the admin console (apps/web) is deployed. Used by the header/footer
# "Login" link. Defaults to the admin console's local dev port if unset.
VITE_ADMIN_CONSOLE_URL=http://localhost:5173

# Play Store / App Store listing URLs, once the rider app is published.
# Left unset today — the "Book Now" / "Get the App" CTAs show a "coming soon"
# state instead of a dead link until these are filled in.
VITE_PLAY_STORE_URL=
VITE_APP_STORE_URL=

# Backend API (public read-only endpoints: plans, fleet + station counts).
# Include /api/v1. Leave blank to run purely on bundled fallback content.
VITE_API_BASE_URL=
