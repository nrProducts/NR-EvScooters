PORT=4000
NODE_ENV=development

# --- Supabase -----------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend only. Bypasses RLS. Never ship this to the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# --- KYC ----------------------------------------------------------------
# Private bucket. Must match storage.buckets.id in 20260717093000_users_kyc.sql.
KYC_BUCKET=kyc-documents
# Keep in sync with that bucket's file_size_limit (default 10 MB).
KYC_MAX_FILE_BYTES=10485760
# Lifetime of a minted signed URL, in seconds.
KYC_SIGNED_URL_TTL_SECONDS=300
# Application-level encryption for kyc_documents.document_number.
# Two DIFFERENT 32-byte secrets: one decrypts, one only builds the search
# index. Generate each with: openssl rand -base64 32
KYC_ENCRYPTION_KEY=
KYC_HMAC_PEPPER=

# --- Geocoding proxy --------------------------------------------------------
# Area search for the rider app's battery-station map.
#
# REQUIRED for the search box to work. The mobile app used to call this
# endpoint DIRECTLY with the rider's exact coordinates — an undisclosed
# disclosure of precise location to a processor with no contract, no log and
# no off switch. It now goes through GET /geocode/search, which coarsens the
# position to ~1 km and forwards no rider identity.
#
# Leave blank and area search degrades to station-name matching (503 handled
# client-side), which is what it did before area search existed.
#
# NOTE: photon.komoot.io is a FREE PUBLIC INSTANCE with no agreement in place.
# Contract with a provider or self-host before launch — see
# docs/dpdpa/processor-dpa-checklist.md.
GEOCODE_URL=https://photon.komoot.io/api
GEOCODE_TIMEOUT_MS=6000
# Decimal places kept on the location bias. 2 dp is roughly 1 km.
GEOCODE_BIAS_PRECISION=2

# Where an invited user lands to set their password.
INVITE_REDIRECT_URL=

# --- Transactional email (Resend) ---------------------------------------
# Leave blank in dev — the server still boots and anything that sends mail
# fails with a clean 503 instead of crashing at startup.
#
# EMAIL_FROM must be an address on a domain you have VERIFIED in Resend,
# e.g. "Swapngo <noreply@swapngo.in>". An unverified sender is rejected.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
# Base URL of the admin console, used for the CTA link in staff notification
# emails, e.g. https://admin.swapngo.in
ADMIN_APP_URL=
# Inbox that receives public website contact-form queries.
CONTACT_INBOX_EMAIL=contact@swapngo.in

# --- MSG91 (phone OTP delivery) ----------------------------------------
# Used by the admin /auth/otp/test diagnostic. The login OTP itself is
# delivered by the send-sms Edge Function, which reads its own copy of these.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=
# Name of the OTP variable in your MSG91 DLT/Flow template (default: otp).
MSG91_OTP_VAR=otp
MSG91_BASE_URL=https://control.msg91.com

# --- Razorpay (payment gateway) ------------------------------------------
# Leave empty in dev — the server still boots; anything that calls the
# gateway throws a clean error instead of crashing at startup.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Configured separately in the Razorpay dashboard against the /payments/webhook URL.
RAZORPAY_WEBHOOK_SECRET=

# Security deposit fallback (rupees) when a plan doesn't set its own deposit_amount.
DEFAULT_DEPOSIT_AMOUNT=2000
# How long a pending_payment booking holds its reserved vehicle before the expiry sweep frees it.
BOOKING_PAYMENT_GRACE_MINUTES=30
# How long a rider has to dispute a recorded damage amount.
DAMAGE_DISPUTE_WINDOW_HOURS=72
# Days after vehicle return before a held deposit becomes refund-eligible.
DEPOSIT_REFUND_ELIGIBILITY_DAYS=15
