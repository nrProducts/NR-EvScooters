# Local env for `supabase functions serve`. In hosted envs set these with
# `supabase secrets set --env-file ...` instead of committing them.

# Generated once; must match [auth.hook.send_sms].secret in config.toml.
# Create with:  openssl rand -base64 33  then prefix with  v1,whsec_
SEND_SMS_HOOK_SECRET=v1,whsec_REPLACE_ME

# MSG91 (see docs/auth/DEVELOPMENT.md and PRODUCTION.md)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=
# Name of the OTP variable in your DLT/Flow template (default: otp)
MSG91_OTP_VAR=otp
MSG91_BASE_URL=https://control.msg91.com

# Razorpay — used by refund-processing and failed-refund-retry to call the
# gateway's refund API directly (same keys as apps/backend/.env).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Comma-separated days-before-due to send a payment-due-reminder push at (0 = due today).
PAYMENT_DUE_REMINDER_DAYS=3,1,0
# Minutes a pending_payment booking is held before booking-payment-expiry-sweep releases its vehicle.
BOOKING_PAYMENT_GRACE_MINUTES=30
# Capped retry attempts for failed-refund-retry.
FAILED_REFUND_MAX_ATTEMPTS=5
